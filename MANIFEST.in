include README.md CHANGELOG.md LICENSE NOTICE LICENSE_SCOPE.md COMMERCIAL_LICENSE.md pyproject.toml MANIFEST.in
recursive-include src/ictc_o2_hp *.py
recursive-include docs *.md *.txt
recursive-include examples *.py
prune docs/history
prune tests
prune benchmarks
exclude AGENTS.md .gitignore
global-exclude *.py[cod] .DS_Store
